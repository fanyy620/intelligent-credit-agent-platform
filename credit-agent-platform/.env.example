# ===== 大模型（DeepSeek，OpenAI 兼容协议）=====
# 不配置时自动降级为内置 MockLLM，demo 与测试仍可运行
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ===== 大模型（Kimi / Moonshot，OpenAI 兼容协议）=====
# provider 探测链：LLM_PROVIDER 显式指定 > auto 下 DEEPSEEK_API_KEY →
# KIMI_API_KEY/MOONSHOT_API_KEY → MockLLM。五层提示词见 docs/prompt-design.md
LLM_PROVIDER=auto
KIMI_API_KEY=
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=kimi-for-coding-highspeed
LLM_TIMEOUT=45
LLM_TEMPERATURE=1
LLM_MAX_TOKENS=2048

# ===== PostgreSQL + PGVector（长期事实记忆 / 产品向量召回）=====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/credit_agent

# ===== Redis（短期会话记忆）=====
REDIS_URL=redis://localhost:6379/0

# ===== Langfuse 可观测（不配置则 tracing 为 no-op，仅内存缓冲）=====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ===== LoRA 意图路由模型（LLaMA-Factory 训练合并后的目录）=====
# 目录不存在或缺少依赖时自动降级为 Prompt 路由
INTENT_MODEL_PATH=models/intent-lora-merged
