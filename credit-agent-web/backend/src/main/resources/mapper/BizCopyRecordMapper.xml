<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.credit.web.mapper.BizCopyRecordMapper">

    <resultMap id="copyMap" type="com.credit.web.entity.BizCopyRecord">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="customerId" column="customer_id"/>
        <result property="productId" column="product_id"/>
        <result property="productName" column="product_name"/>
        <result property="channel" column="channel"/>
        <result property="template" column="template"/>
        <result property="content" column="content"/>
        <result property="compliant" column="compliant"/>
        <result property="hitRules" column="hit_rules"/>
        <result property="conclusion" column="conclusion"/>
        <result property="createTime" column="create_time"/>
        <result property="username" column="username"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO biz_copy_record
            (user_id, customer_id, product_id, product_name, channel,
             template, content, compliant, hit_rules, conclusion)
        VALUES
            (#{userId}, #{customerId}, #{productId}, #{productName}, #{channel},
             #{template}, #{content}, #{compliant}, #{hitRules}, #{conclusion})
    </insert>

    <select id="countByCondition" resultType="long">
        SELECT COUNT(*) FROM biz_copy_record r
        <where>
            <if test="onlyViolation != null and onlyViolation">
                AND r.compliant = 0
            </if>
        </where>
    </select>

    <select id="selectPageByCondition" resultMap="copyMap">
        SELECT r.*, u.username
        FROM biz_copy_record r
        LEFT JOIN sys_user u ON r.user_id = u.id
        <where>
            <if test="onlyViolation != null and onlyViolation">
                AND r.compliant = 0
            </if>
        </where>
        ORDER BY r.id DESC
        LIMIT #{offset}, #{limit}
    </select>
</mapper>
