<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.credit.web.mapper.BizRecommendRecordMapper">

    <resultMap id="recordMap" type="com.credit.web.entity.BizRecommendRecord">
        <id property="id" column="id"/>
        <result property="sessionId" column="session_id"/>
        <result property="customerId" column="customer_id"/>
        <result property="userId" column="user_id"/>
        <result property="message" column="message"/>
        <result property="topProduct" column="top_product"/>
        <result property="resultJson" column="result_json"/>
        <result property="createTime" column="create_time"/>
        <result property="customerName" column="customer_name"/>
        <result property="username" column="username"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO biz_recommend_record
            (session_id, customer_id, user_id, message, top_product, result_json)
        VALUES
            (#{sessionId}, #{customerId}, #{userId}, #{message}, #{topProduct}, #{resultJson})
    </insert>

    <select id="countByCondition" resultType="long">
        SELECT COUNT(*) FROM biz_recommend_record r
        <where>
            <if test="customerId != null">
                AND r.customer_id = #{customerId}
            </if>
        </where>
    </select>

    <select id="selectPageByCondition" resultMap="recordMap">
        SELECT r.*, c.name AS customer_name, u.username
        FROM biz_recommend_record r
        LEFT JOIN biz_customer c ON r.customer_id = c.id
        LEFT JOIN sys_user u ON r.user_id = u.id
        <where>
            <if test="customerId != null">
                AND r.customer_id = #{customerId}
            </if>
        </where>
        ORDER BY r.id DESC
        LIMIT #{offset}, #{limit}
    </select>
</mapper>
